# Values below match config.py's current defaults as of this commit. If a
# default changes in code, this file must be updated to match - verify before
# relying on it.

# Gemini API (used in extraction.py)
GEMINI_API_KEY=your_key_here
# Overrides extraction.py's fallback (gemini-3.5-flash). gemini-3.5-flash-lite
# is the recommended default - confirmed live and chosen for cost/throughput,
# per notes.md's Level 2 entry.
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase / Postgres connection (used in server.py, scripts/migrate.py, scripts/vectorize.py)
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=6543

# --- Redis -------------------------------------------------------------------
# db 0 = Celery broker + results (durable). db 1 = search cache (disposable).
# Under docker compose these become redis://redis:6379/0 and /1.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# --- Celery ------------------------------------------------------------------
# See the derivation in celery_app.py before changing these.
WORKER_CONCURRENCY=4
# 14/m, not 15: the free-tier quota is 15 req/min for gemini-3.5-flash-lite,
# confirmed by a live 429 ("limit: 15") during a 46-file load test. One
# request of headroom absorbs clock skew between our limiter and Google's.
GEMINI_RATE_LIMIT=14/m
TASK_SOFT_TIME_LIMIT=120
TASK_TIME_LIMIT=150
TASK_MAX_RETRIES=5
# Redis has no server-side ack; kombu emulates one by holding delivered
# messages in an `unacked` hash and only requeueing after this timeout. Left
# unset, kombu's 3600s default applies and a killed worker's in-flight tasks
# sit stranded for an hour - observed as a job frozen at 19/23. Must exceed
# task_time_limit (150s) and the longest retry backoff, or a slow-but-healthy
# task gets redelivered while still running.
BROKER_VISIBILITY_TIMEOUT=900

# --- Search cache ------------------------------------------------------------
SEARCH_CACHE_TTL=60
SEARCH_CACHE_ENABLED=true

# --- Upload limits -----------------------------------------------------------
MAX_ZIP_FILES=500
MAX_ZIP_TOTAL_BYTES=524288000
MAX_SINGLE_FILE_BYTES=26214400
MAX_ZIP_COMPRESSION_RATIO=100
# Renamed from JOB_TTL_SECONDS during the batch_id sweep. config.py reads
# BATCH_TTL_SECONDS; the old key was silently ignored.
BATCH_TTL_SECONDS=86400
